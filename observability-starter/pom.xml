<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
   <modelVersion>4.0.0</modelVersion>

   <parent>
      <groupId>com.vspiewak</groupId>
      <artifactId>spring-gcp-observability</artifactId>
      <version>0.0.1-SNAPSHOT</version>
   </parent>

   <artifactId>observability-starter</artifactId>

   <dependencies>
      <!-- Spring Boot's own OpenTelemetry starter : Micrometer over the OpenTelemetry SDK, OTLP export -->
      <dependency>
         <groupId>org.springframework.boot</groupId>
         <artifactId>spring-boot-starter-opentelemetry</artifactId>
      </dependency>
      <!-- brought at runtime by the starter ; declared because the token bean builds against it -->
      <dependency>
         <groupId>io.opentelemetry</groupId>
         <artifactId>opentelemetry-exporter-otlp</artifactId>
      </dependency>
      <!-- @Observed -->
      <dependency>
         <groupId>org.springframework.boot</groupId>
         <artifactId>spring-boot-starter-aspectj</artifactId>
      </dependency>

      <!-- Google Cloud, the Spring way : credentials and project, shared with every Spring Cloud GCP starter -->
      <dependency>
         <groupId>com.google.cloud</groupId>
         <artifactId>spring-cloud-gcp-starter</artifactId>
      </dependency>

      <!-- MongoDB driver tracing, for the services that have a MongoDB -->
      <dependency>
         <groupId>org.springframework.boot</groupId>
         <artifactId>spring-boot-mongodb</artifactId>
         <optional>true</optional>
      </dependency>
      <dependency>
         <groupId>org.mongodb</groupId>
         <artifactId>mongodb-driver-core</artifactId>
         <optional>true</optional>
      </dependency>

      <dependency>
         <groupId>org.springframework.boot</groupId>
         <artifactId>spring-boot-starter-test</artifactId>
         <scope>test</scope>
      </dependency>
   </dependencies>

</project>
