<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
   <modelVersion>4.0.0</modelVersion>

   <parent>
      <groupId>com.vspiewak</groupId>
      <artifactId>spring-gcp-observability</artifactId>
      <version>0.0.1-SNAPSHOT</version>
   </parent>

   <artifactId>observability-starter</artifactId>

   <dependencies>
      <dependency>
         <groupId>org.springframework.boot</groupId>
         <artifactId>spring-boot-starter</artifactId>
      </dependency>

      <!-- tracing : Micrometer over the OpenTelemetry SDK, exported over plain OTLP -->
      <dependency>
         <groupId>org.springframework.boot</groupId>
         <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
      </dependency>
      <dependency>
         <groupId>io.micrometer</groupId>
         <artifactId>micrometer-tracing-bridge-otel</artifactId>
      </dependency>
      <dependency>
         <groupId>io.opentelemetry</groupId>
         <artifactId>opentelemetry-exporter-otlp</artifactId>
      </dependency>
      <!-- @Observed -->
      <dependency>
         <groupId>org.springframework.boot</groupId>
         <artifactId>spring-boot-starter-aspectj</artifactId>
      </dependency>

      <!-- Google Cloud : the access token for the trace export, nothing else -->
      <dependency>
         <groupId>com.google.auth</groupId>
         <artifactId>google-auth-library-oauth2-http</artifactId>
      </dependency>

      <!-- MongoDB driver tracing, for the services that have a MongoDB -->
      <dependency>
         <groupId>org.springframework.boot</groupId>
         <artifactId>spring-boot-mongodb</artifactId>
         <optional>true</optional>
      </dependency>
      <dependency>
         <groupId>org.mongodb</groupId>
         <artifactId>mongodb-driver-core</artifactId>
         <optional>true</optional>
      </dependency>

      <dependency>
         <groupId>org.springframework.boot</groupId>
         <artifactId>spring-boot-starter-test</artifactId>
         <scope>test</scope>
      </dependency>
   </dependencies>

</project>
